<robot name="dogg">

    <link name="base_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <box size="0.01 0.01 0.01"/>
        </geometry>  
    </visual>     
    </link>


    <link name="trunk">
    <visual>
        <origin xyz="0.18 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/trunk.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <link name="thigh_1">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/thigh.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="base_link_to_trunk" type="fixed">
        <origin xyz="0.0 0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="trunk"/>
    </joint>

    <joint name="hip_and_thigh_1" type="revolute">
        <origin xyz="0.0 -0.05 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="hip_1"/>
        <child link="thigh_1"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <link name="thigh_2">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/thigh_mirror.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="hip_to_thigh_2" type="revolute">
        <origin xyz="0.0 0.05 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="hip_2"/>
        <child link="thigh_2"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- Thigh 3 and the joint to the hip -->
    <link name="thigh_3">
    <visual>
        <origin xyz="0.0 0.11 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/thigh_mirror.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="hip_to_thigh_3" type="revolute">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="hip_3"/>
        <child link="thigh_3"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- Thigh 4 and the joint to the hip -->
    <link name="thigh_4">
    <visual>
        <origin xyz="0.0 -0.11 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/thigh.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="hip_to_thigh_4" type="revolute">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="hip_4"/>
        <child link="thigh_4"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

     <!-- Calf 1 to thigh 1 -->
    <link name="calf_1">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/calf.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="thigh_to_calf_1" type="revolute">
        <origin xyz="0.00 0.0 -0.22" rpy="0.0 0.0 0.0"/>
        <parent link="thigh_1"/>
        <child link="calf_1"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- Calf 2 to thigh 2 -->
    <link name="calf_2">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/calf.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="thigh_to_calf_2" type="revolute">
        <origin xyz="0.00 0.0 -0.22" rpy="0.0 0.0 0.0"/>
        <parent link="thigh_2"/>
        <child link="calf_2"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- Calf 3 to thigh 3 -->
    <link name="calf_3">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/calf.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="thigh_to_calf_3" type="revolute">
        <origin xyz="0.00 0.11 -0.22" rpy="0.0 0.0 0.0"/>
        <parent link="thigh_3"/>
        <child link="calf_3"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- Calf 4 to thigh 4 -->
    <link name="calf_4">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/calf.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="thigh_to_calf_4" type="revolute">
        <origin xyz="0.00 -0.11 -0.22" rpy="0.0 0.0 0.0"/>
        <parent link="thigh_4"/>
        <child link="calf_4"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- hip-->
    <link name="hip_1">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/hip.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>  
    </link>

    <link name="hip_2">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/hip.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>  
    </link>

    <link name="hip_3">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/hip.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>  
    </link>

    <link name="hip_4">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/hip.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>  
    </link>

    <!-- Trunk to hip -->
    <joint name="trunk_to_hip_1" type="revolute">
        <origin xyz="-0.01 -0.05 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="trunk"/>
        <child link="hip_1"/>
        <axis xyz="1 0 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <joint name="trunk_to_hip_2" type="revolute">
        <origin xyz="-0.01 0.05 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="trunk"/>
        <child link="hip_2"/>
        <axis xyz="1 0 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <joint name="trunk_to_hip_3" type="revolute">
        <origin xyz="0.3 -0.03 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="trunk"/>
        <child link="hip_3"/>
        <axis xyz="1 0.0 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <joint name="trunk_to_hip_4" type="revolute">
        <origin xyz="0.3 0.03 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="trunk"/>
        <child link="hip_4"/>
        <axis xyz="1 0 0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- Depth camera and the linking to the trunk -->
    <link name="depth_camera">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/depthCamera.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="depthcamera_to_trunk" type="fixed">
        <origin xyz="-0.07 0.02 0.02" rpy="0.0 0.0 0.0"/>
        <parent link="trunk"/>
        <child link="depth_camera"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- Ultrasound and the linking to the trunk -->
    <link name="ultrasound">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 3.14"/>
        <geometry>
            <mesh filename="package://dogg_description/meshes/ultraSound.dae" scale="1.0 1.0 1.0"/>>
        </geometry>  
    </visual>     
    </link>

    <joint name="ultrasound_to_trunk" type="fixed">
        <origin xyz="-0.07 0.01 -0.02" rpy="0.0 0.0 0.0"/>
        <parent link="trunk"/>
        <child link="ultrasound"/>
        <axis xyz="0.00 1 0.0"/>
        <limit lower="-3.14" upper="3.14" effort="0.0" velocity="0.0"/>
    </joint>
</robot>